# Public browser configuration. Never put server secrets in VITE_ variables.
VITE_SERVER_URL=http://localhost:8000

# Copy the web app configuration from your Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public Razorpay key ID; use the same test/live mode as the billing service.
VITE_RAZORPAY_KEY_ID=
