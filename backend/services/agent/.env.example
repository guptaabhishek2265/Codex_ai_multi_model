PORT=8003
MONGODB_URI=mongodb://127.0.0.1:27017/agentverse
REDIS_URL=redis://localhost:6379
AUTH_SERVICE=http://localhost:8001
CHAT_SERVICE=http://localhost:8002

# AI providers (SDKs read these environment variable names).
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=

# Image generation uses the authenticated Pollinations API.
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=flux

# PDF retrieval: local Qdrant needs no API key by default.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# S3 storage for generated PDFs, presentations, and images.
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed when using temporary AWS credentials.
AWS_SESSION_TOKEN=
